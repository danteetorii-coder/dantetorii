# Chave da API Anthropic (obrigatório)
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Modelo Claude a utilizar (opcional, padrão: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# Caminho para o arquivo de armazenamento de leads (opcional)
LEADS_STORAGE_PATH=data/leads.json
